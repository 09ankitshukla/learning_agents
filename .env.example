# Copy this file to `.env` and edit. `.env` is gitignored; this file is not.
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Every lesson reads these three variables and nothing else. Switching between a
# model on your laptop and a hosted API is a one-line change here -- no code edits.

# ---------------------------------------------------------------------------
# TIER 1 - HOSTED OPEN-SOURCE MODELS (recommended start; free key, no download)
# Open weights on someone else's GPUs. Fast enough for every lesson including
# the eval-heavy ones.
# ---------------------------------------------------------------------------
# Groq -- free key at https://console.groq.com
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_your_key_here

# Other models Groq served as of this writing. Providers retire models often, so
# run `uv run lessons/00-setup/check_env.py` to see the current list rather than
# trusting this comment.
#   openai/gpt-oss-20b     smaller, cheaper, weaker -- good for size comparisons
#   qwen/qwen3.8-27b       different family, useful for A/B tests in lesson 9
# Note: gpt-oss models are REASONING models. They spend most of their output
# budget on hidden deliberation, so keep max_tokens generous (>= 500) or you get
# empty answers. Lesson 0 experiment 5 demonstrates this.

# OpenRouter -- has :free model variants, key at https://openrouter.ai
# LLM_PROVIDER=openrouter
# LLM_MODEL=qwen/qwen-2.5-72b-instruct
# LLM_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# TIER 2 - LOCAL, NO API KEY (fully offline, no cost, slow without a GPU)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_TIMEOUT=180

# Faster but weaker at tool calling -- good for quick iteration:
# LLM_MODEL=qwen2.5:3b-instruct

# llama.cpp's server instead of Ollama (see lessons/00-setup/README.md):
# LLM_PROVIDER=llamacpp
# LLM_MODEL=local-model

# ---------------------------------------------------------------------------
# TIER 3 - COMMERCIAL MODELS (for people cloning this repo who prefer them)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
# Point at any OpenAI-compatible server (vLLM, LM Studio, a proxy):
# LLM_BASE_URL=http://localhost:8000/v1

# Seconds before a request is abandoned. 60 is plenty for a hosted API. Raise it
# to 180+ for local CPU inference, where a long prompt can take minutes and a
# timeout looks exactly like a model failure.
LLM_TIMEOUT=60
